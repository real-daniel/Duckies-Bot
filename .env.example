# Required
DISCORD_TOKEN=

# Optional: use a development server ID for immediate command registration.
DISCORD_GUILD_ID=

# Optional: raises upstream Deadlock API rate limits.
DEADLOCK_API_KEY=

# Optional overrides
TARKOV_API_URL=https://json.tarkov.dev
DEADLOCK_API_URL=https://api.deadlock-api.com
HTTP_TIMEOUT_SECONDS=30

# Companion API. Keep this on loopback when Nginx runs on the same VPS.
COMPANION_API_HOST=127.0.0.1
COMPANION_API_PORT=8080

# Set after DNS and Nginx HTTPS are configured. No trailing slash.
COMPANION_PUBLIC_URL=
