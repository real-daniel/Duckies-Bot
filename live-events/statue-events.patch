             game_time: 0.0,
             tick_interval: 1.0 / 60.0,
             rules: GameRulesProxyEvent::default(),
@@ -212,6 +214,8 @@ impl SendingVisitor {
             self.game_time = total_time - self.rules.game_start_time.unwrap_or_default();
         }
 
+        self.handle_statue_buffs(ctx)?;
+
         let demo_event = DemoEvent {
             tick: ctx.tick(),
             game_time: self.game_time,
@@ -220,4 +224,89 @@ impl SendingVisitor {
         self.sender.send(demo_event.try_into()?)?;
         Ok(())
     }
+
+    fn handle_statue_buffs(&mut self, ctx: &Context) -> Result<(), DemoParseError> {
+        let Some(table) = ctx
+            .string_tables()
+            .and_then(|tables| tables.find_table("ActiveModifiers"))
+        else {
+            return Ok(());
+        };
+
+        for (entry_id, item) in table.items() {
+            if self.seen_modifier_entries.contains(entry_id) {
+                continue;
+            }
+            let Some(data) = item.get_user_data() else {
+                continue;
+            };
+            let Ok(modifier) = ModifierTableEntry::decode(data.as_slice()) else {
+                continue;
+            };
+            self.seen_modifier_entries.insert(*entry_id);
+            if modifier.entry_type.unwrap_or(1) != 1 {
+                continue;
+            }
+            let Some(parent) = modifier.parent else {
+                continue;
+            };
+            let Some(modifier_subclass) = modifier.modifier_subclass else {
+                continue;
+            };
+            let Some((stat, tier)) = statue_buff(modifier_subclass) else {
+                continue;
+            };
+
+            let event = DemoEvent {
+                tick: ctx.tick(),
+                game_time: self.game_time,
+                event: DemoEventPayload::StatueBuff {
+                    entry_id: *entry_id,
+                    parent: ehandle_to_index(parent),
+                    serial_number: modifier.serial_number,
+                    modifier_subclass,
+                    stat,
+                    tier,
+                },
+            };
+            self.sender.send(event.try_into()?)?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, PartialEq, Message)]
+struct ModifierTableEntry {
+    #[prost(int32, optional, tag = "1")]
+    entry_type: Option<i32>,
+    #[prost(uint32, optional, tag = "2")]
+    parent: Option<u32>,
+    #[prost(uint32, optional, tag = "3")]
+    serial_number: Option<u32>,
+    #[prost(uint32, optional, tag = "4")]
+    modifier_subclass: Option<u32>,
+}
+
+fn statue_buff(modifier_subclass: u32) -> Option<(&'static str, u8)> {
+    Some(match modifier_subclass {
+        2_201_601_853 => ("spirit", 1),
+        2_345_479_643 => ("fire_rate", 1),
+        2_889_034_835 => ("ammo", 1),
+        305_643_471 => ("health", 1),
+        891_412_337 => ("cooldown", 1),
+        1_058_891_786 => ("weapon_power", 1),
+        3_992_882_918 => ("spirit", 2),
+        386_684_932 => ("fire_rate", 2),
+        2_592_582_493 => ("ammo", 2),
+        1_781_761_146 => ("health", 2),
+        894_425_830 => ("cooldown", 2),
+        1_433_909_151 => ("weapon_power", 2),
+        488_089_530 => ("spirit", 3),
+        3_061_460_371 => ("fire_rate", 3),
+        1_782_442_278 => ("ammo", 3),
+        2_902_074_031 => ("health", 3),
+        2_271_692_252 => ("cooldown", 3),
+        3_448_082_679 => ("weapon_power", 3),
+        _ => return None,
+    })
 }
